# Copy this file to .env.local and fill in real values.
# Every variable is server-only. Never prefix them with NEXT_PUBLIC_.

# Supabase: Project Settings -> Data API (URL) and API Keys (secret key, sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key and model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Per-bill spending limit in cents (100000 = $1,000.00)
POLICY_LIMIT_MINOR_UNITS=100000

# Shows the "Reset demo" button and enables POST /api/demo/reset
DEMO_MODE=true
